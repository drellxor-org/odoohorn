<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_application_tree" model="ir.ui.view">
        <field name="name">product.application.tree</field>
        <field name="model">product.application</field>
        <field name="arch" type="xml">
            <tree string="Applications" editable="bottom">
                <field name="product_tmpl_id"/>
                <field name="make_id"/>
                <field name="model"/>
                <field name="serie"/>
                <field name="vehicle_brand"/>
                <field name="vehicle_type_code" optional="hide"/>
                <field name="engine_brand" optional="hide"/>
                <field name="engine_series" optional="hide"/>
                <field name="engine_model" optional="hide"/>
                <field name="brochure_id"/>
            </tree>
        </field>
    </record>

    <record id="product_application_form" model="ir.ui.view">
        <field name="name">product.application.form</field>
        <field name="model">product.application</field>
        <field name="arch" type="xml">
            <form string="Application">
                <sheet>
                    <group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="make_id"/>
                            <field name="model"/>
                            <field name="serie"/>
                        </group>
                        <group>
                            <field name="vehicle_brand"/>
                            <field name="vehicle_type_code"/>
                            <field name="engine_brand"/>
                            <field name="engine_series"/>
                            <field name="engine_model"/>
                            <field name="brochure_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_application_search" model="ir.ui.view">
        <field name="name">product.application.search</field>
        <field name="model">product.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="make_id"/>
                <field name="model"/>
                <field name="serie"/>
                <field name="vehicle_brand"/>
                <field name="brochure_id"/>
                <filter name="without_brochure" string="Without brochure"
                        domain="[('brochure_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_make" string="Make"
                            domain="[]" context="{'group_by': 'make_id'}"/>
                    <filter name="group_by_brochure" string="Brochure"
                            domain="[]" context="{'group_by': 'brochure_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_product_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">product.application</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
