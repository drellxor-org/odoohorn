<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tvh" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.tvh</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="TVH API" string="TVH API" data-key="product_catalog">
                    <h2>TVH REST API</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="tvh_api_url"/>
                                <div class="text-muted">
                                    Defaults to https://api.tvh.com
                                </div>
                                <field name="tvh_api_url"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="tvh_customer_code"/>
                                <div class="text-muted">
                                    Account number passed in the customerCode path segment.
                                </div>
                                <field name="tvh_customer_code"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="tvh_customer_contact_name"/>
                                <div class="text-muted">
                                    Sent as customerContactName in each /inquiries payload.
                                </div>
                                <field name="tvh_customer_contact_name"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="tvh_api_username"/>
                                <div class="text-muted">
                                    e.g. 00000001+rest@tvh.com
                                </div>
                                <field name="tvh_api_username"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="tvh_api_password"/>
                                <field name="tvh_api_password" password="True"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_tvh_settings" model="ir.actions.act_window">
        <field name="name">TVH settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'product_catalog'}</field>
    </record>
</odoo>
