    <p style="margin: 0px; padding: 0px; font-size: 16px;">
        New order <span style="font-weight:bold;" t-out="object.name or ''"/> (<span t-out="order_date"/>)
        <br/><br/>
        Name: <t t-out="object.partner_id.name or ''"/><br/>
        Email: <t t-out="object.partner_id.email or ''"/><br/>
        Phone: <t t-out="object.partner_id.phone or ''"/><br/>
        Commentary: <t t-out="object.partner_id.comment or ''"/><br/>
        Country of delivery: <t t-out="ship_country"/>
        <t t-if="not is_html_empty(object.user_id.signature)">
