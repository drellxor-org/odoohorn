<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="sale.mail_template_sale_confirmation" model="mail.template">
            <field name="name">Sales: Order Confirmation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">{{ object.company_id.name }} Order (Ref {{ object.name or 'n/a' }})</field>
            <field name="email_from">"{{ object.company_id.name }}" &lt;noreply@silverhorn.co.uk&gt;</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Sent to customers on order confirmation</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 12px;">
        Hello, <t t-out="object.partner_id.name"/>
        <br/><br/>
        Your enquiry <span style="font-weight:bold;" t-out="object.name or ''">S00049</span> has been confirmed.<br/>
        Thank you for your trust!
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <br/><br/>
            <t t-out="object.user_id.signature or ''">--<br/>Mitchell Admin</t>
        </t>
        <br/><br/>
    </p>
    <t t-set="products" t-value="object.order_line.filtered(lambda l: (not hasattr(l, 'is_delivery') or not l.is_delivery))"/>
    <t t-set="parts" t-value="object.brochure_line_ids if hasattr(object, 'brochure_line_ids') else []"/>

    <t t-if="products">
        <div style="margin: 0px 0px 20px 0px; padding: 0px;">
            <table width="100%" style="color: #454748; font-size: 12px; border-collapse: collapse;">
                <tr style="border-bottom: 2px solid #dee2e6;">
                    <td><span style="font-weight:bold;">Products</span></td>
                    <td width="15%" align="center"><span style="font-weight:bold;">Quantity</span></td>
                </tr>
            </table>
            <t t-foreach="products" t-as="line">
                <table width="100%" style="color: #454748; font-size: 12px; border-collapse: collapse;">
                    <t t-set="loop_cycle_number" t-value="loop_cycle_number or 0" />
                    <tr t-att-style="'background-color: #f2f2f2' if loop_cycle_number % 2 == 0 else 'background-color: #ffffff'">
                        <t t-set="loop_cycle_number" t-value="loop_cycle_number + 1" />
                        <t t-if="line.display_type == 'line_section'">
                            <td colspan="2"><span style="font-weight:bold;" t-out="line.name or ''"/></td>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <td colspan="2"><i t-out="line.name or ''"/></td>
                        </t>
                        <t t-else="">
                            <td align="left" t-out="line.product_id.name or ''"/>
                            <td width="15%" align="center" t-out="line.product_uom_qty or ''"/>
                        </t>
                    </tr>
                </table>
            </t>
        </div>
    </t>

    <t t-if="parts">
        <t t-set="base_url" t-value="object.env['ir.config_parameter'].sudo().get_param('web.base.url') or ''"/>
        <div style="margin: 0px; padding: 0px;">
            <table width="100%" style="color: #454748; font-size: 12px; border-collapse: collapse;">
                <tr style="border-bottom: 2px solid #dee2e6;">
                    <td><span style="font-weight:bold;">Brochure</span></td>
                    <td align="center"><span style="font-weight:bold;">Make</span></td>
                    <td align="center"><span style="font-weight:bold;">Model / Serial</span></td>
                    <td align="center"><span style="font-weight:bold;">Part number</span></td>
                    <td align="center"><span style="font-weight:bold;">Description</span></td>
                    <td align="center"><span style="font-weight:bold;">Commentary</span></td>
                    <td width="10%" align="center"><span style="font-weight:bold;">Quantity</span></td>
                </tr>
            </table>
            <t t-foreach="parts" t-as="part">
                <table width="100%" style="color: #454748; font-size: 12px; border-collapse: collapse;">
                    <t t-set="parts_cycle" t-value="parts_cycle or 0" />
                    <tr t-att-style="'background-color: #f2f2f2' if parts_cycle % 2 == 0 else 'background-color: #ffffff'">
                        <t t-set="parts_cycle" t-value="parts_cycle + 1" />
                        <td align="left">
                            <t t-if="part.brochure_id">
                                <a t-att-href="base_url + (part.brochure_id.website_slug or '')" t-out="part.brochure_id.name or ''"/>
                            </t>
                            <t t-else="">
                                <span t-out="''"/>
                            </t>
                        </td>
                        <td align="center" t-out="part.make or ''"/>
                        <td align="center" t-out="part.machine_serial or ''"/>
                        <td align="center" t-out="part.part_number or ''"/>
                        <td align="center" t-out="part.name or ''"/>
                        <td align="center" t-out="part.commentary or ''"/>
                        <td width="10%" align="center" t-out="part.quantity or ''"/>
                    </tr>
                </table>
            </t>
        </div>
    </t>
</div></field>
            <field name="report_template"/>
            <field name="report_name">{{ (object.name or '').replace('/','_') }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>


