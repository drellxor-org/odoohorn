<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_tvh_refresh_codes" model="ir.cron">
        <field name="name">TVH: refresh availability + unit codes</field>
        <field name="model_id" ref="model_tvh_service"/>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_codes()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_tvh_import" model="ir.cron">
        <field name="name">TVH: daily FTPS import (catalog, applications, prices, stock, images)</field>
        <field name="model_id" ref="model_tvh_import"/>
        <field name="state">code</field>
        <field name="code">model.cron_import()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- TVH drops the daily stock file around 09:15 UTC -->
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 10:00:00')"/>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
