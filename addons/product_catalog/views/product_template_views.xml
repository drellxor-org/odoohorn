<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherits used by the *standard* product menus (Sales, Inventory, etc.).
         Only adds catalog fields; doesn't touch existing tabs. -->
    <record id="product_template_form_catalog" model="ir.ui.view">
        <field name="name">product.template.form.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_refresh_from_tvh" type="object"
                            string="Refresh from TVH" class="oe_highlight"
                            attrs="{'invisible': [('data_source_id', '=', False)]}"/>
                </header>
            </xpath>
            <!-- Prepend the catalog tabs so they're visible without scrolling the notebook overflow. -->
            <xpath expr="//notebook/page[1]" position="before">
                <page string="Catalog" name="catalog">
                    <group>
                        <group string="Source">
                            <field name="data_source_id"/>
                            <field name="make_id"/>
                            <field name="is_dangerous_goods"/>
                        </group>
                        <group string="Packaged dimensions">
                            <field name="weight_gr"/>
                            <field name="length_mm"/>
                            <field name="width_mm"/>
                            <field name="height_mm"/>
                        </group>
                    </group>
                </page>
                <page string="Applications" name="applications">
                    <field name="application_ids">
                        <tree editable="bottom">
                            <field name="make_id"/>
                            <field name="model"/>
                            <field name="serie"/>
                            <field name="vehicle_brand" optional="hide"/>
                            <field name="vehicle_type_code" optional="hide"/>
                            <field name="engine_brand" optional="hide"/>
                            <field name="engine_model" optional="hide"/>
                            <field name="brochure_id"/>
                        </tree>
                    </field>
                </page>
                <page string="TVH" name="tvh">
                    <group>
                        <group string="Pricing">
                            <field name="tvh_price" readonly="1"/>
                            <field name="tvh_pricefile_price"/>
                            <field name="tvh_list_price" readonly="1"/>
                            <field name="surcharge_amount" readonly="1"/>
                            <field name="environmental_fee" readonly="1"/>
                        </group>
                        <group string="Stock">
                            <field name="tvh_quantity_in_stock" readonly="1"/>
                            <field name="tvh_quantity_in_stock_be" readonly="1"/>
                            <field name="availability_code_id" readonly="1"/>
                            <field name="tvh_quantity_updated_at" readonly="1"/>
                        </group>
                        <group string="Identifiers">
                            <field name="tvh_number" readonly="1"/>
                            <field name="quality_brand" readonly="1"/>
                            <field name="unit_code_id" readonly="1"/>
                            <field name="stock_unit_matrix_desc" readonly="1"/>
                        </group>
                        <group string="Flags">
                            <field name="is_reconditioned" readonly="1"/>
                            <field name="is_non_returnable" readonly="1"/>
                            <field name="is_non_cancellable" readonly="1"/>
                            <field name="minimum_order_quantity"/>
                            <field name="not_orderable_reason" readonly="1"/>
                        </group>
                        <group string="Replacement chain" colspan="2">
                            <field name="replaced_by_id" readonly="1"/>
                            <field name="latest_product_id" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Quantity discounts"/>
                    <field name="tvh_quantity_discount_ids" readonly="1">
                        <tree>
                            <field name="qty"/>
                            <field name="price"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_catalog" model="ir.ui.view">
        <field name="name">product.template.tree.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="make_id" optional="show"/>
                <field name="data_source_id" optional="hide"/>
                <field name="is_dangerous_goods" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_catalog" model="ir.ui.view">
        <field name="name">product.template.search.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="make_id"/>
                <field name="data_source_id"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <filter name="filter_dangerous" string="Dangerous goods"
                        domain="[('is_dangerous_goods','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_make" string="Make" domain="[]"
                            context="{'group_by': 'make_id'}"/>
                    <filter name="group_by_data_source" string="Data source" domain="[]"
                            context="{'group_by': 'data_source_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Dedicated form for the Catalog → Products menu.
         Standalone (no inherit_id) so unrelated addons that piled into the standard
         form (product_attachment, etc.) don't bleed into this view. -->
    <record id="product_template_form_catalog_only" model="ir.ui.view">
        <field name="name">product.template.form.catalog.only</field>
        <field name="model">product.template</field>
        <field name="priority" eval="32"/>
        <field name="arch" type="xml">
            <form string="Product">
                <header>
                    <button name="action_refresh_from_tvh" type="object"
                            string="Refresh from TVH" class="oe_highlight"
                            attrs="{'invisible': [('data_source_id', '=', False)]}"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options='{"preview_image": "image_128"}'/>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <label for="name" string="Name"/>
                        <h1><field name="name" placeholder="Product name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="type"/>
                            <field name="default_code"/>
                            <field name="make_id"/>
                            <field name="public_categ_ids" widget="many2many_tags"/>
                            <field name="is_dangerous_goods"/>
                        </group>
                        <group>
                            <field name="list_price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="sale_ok"/>
                            <field name="purchase_ok"/>
                            <field name="data_source_id" readonly="1"/>
                            <field name="website_slug" readonly="1"/>
                            <field name="website_slug_override"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description_sale"
                                   placeholder="Sales description shown to customers."/>
                        </page>
                        <page string="Page Message" name="page_message">
                            <field name="page_message"/>
                        </page>
                        <page string="Packaging" name="packaging">
                            <group>
                                <group string="Original (from catalog)">
                                    <field name="weight_gr"/>
                                    <field name="length_mm"/>
                                    <field name="width_mm"/>
                                    <field name="height_mm"/>
                                </group>
                                <group string="Odoo native">
                                    <field name="weight"/>
                                    <field name="volume"/>
                                </group>
                            </group>
                        </page>
                        <page string="Applications" name="applications">
                            <field name="application_ids">
                                <tree editable="bottom">
                                    <field name="make_id"/>
                                    <field name="model"/>
                                    <field name="serie"/>
                                    <field name="vehicle_brand" optional="hide"/>
                                    <field name="vehicle_type_code" optional="hide"/>
                                    <field name="engine_brand" optional="hide"/>
                                    <field name="engine_model" optional="hide"/>
                                    <field name="brochure_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="TVH" name="tvh">
                            <group>
                                <group string="Pricing">
                                    <field name="tvh_price" readonly="1"/>
                                    <field name="tvh_pricefile_price"/>
                                    <field name="tvh_list_price" readonly="1"/>
                                    <field name="surcharge_amount" readonly="1"/>
                                    <field name="environmental_fee" readonly="1"/>
                                </group>
                                <group string="Stock">
                                    <field name="tvh_quantity_in_stock" readonly="1"/>
                                    <field name="tvh_quantity_in_stock_be" readonly="1"/>
                                    <field name="availability_code_id" readonly="1"/>
                                    <field name="tvh_quantity_updated_at" readonly="1"/>
                                </group>
                                <group string="Identifiers">
                                    <field name="tvh_number" readonly="1"/>
                                    <field name="quality_brand" readonly="1"/>
                                    <field name="unit_code_id" readonly="1"/>
                                    <field name="stock_unit_matrix_desc" readonly="1"/>
                                </group>
                                <group string="Flags">
                                    <field name="is_reconditioned" readonly="1"/>
                                    <field name="is_non_returnable" readonly="1"/>
                                    <field name="is_non_cancellable" readonly="1"/>
                                    <field name="minimum_order_quantity"/>
                                    <field name="not_orderable_reason" readonly="1"/>
                                </group>
                                <group string="Replacement chain" colspan="2">
                                    <field name="replaced_by_id" readonly="1"/>
                                    <field name="latest_product_id" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Quantity discounts"/>
                            <field name="tvh_quantity_discount_ids" readonly="1">
                                <tree>
                                    <field name="qty"/>
                                    <field name="price"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Alternatives" name="alternatives">
                            <field name="alternative_product_ids">
                                <tree>
                                    <field name="default_code"/>
                                    <field name="name"/>
                                    <field name="make_id"/>
                                    <field name="quality_brand"/>
                                    <field name="list_price"/>
                                </tree>
                            </field>
                        </page>
                        <page string="SEO" name="seo">
                            <group>
                                <field name="website_meta_title"/>
                                <field name="website_meta_description"/>
                                <field name="website_meta_keywords"/>
                                <field name="website_meta_og_img"/>
                                <field name="json_ld"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_template_catalog" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <record id="action_product_template_catalog_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="act_window_id" ref="action_product_template_catalog"/>
    </record>
    <record id="action_product_template_catalog_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="act_window_id" ref="action_product_template_catalog"/>
    </record>
    <record id="action_product_template_catalog_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="product_template_form_catalog_only"/>
        <field name="act_window_id" ref="action_product_template_catalog"/>
    </record>

</odoo>
