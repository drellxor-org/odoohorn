<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- =========================================================
             CUSTOMER: Order Confirmation
             ========================================================= -->
        <record id="sale.mail_template_sale_confirmation" model="mail.template">
            <field name="name">Sales: Order Confirmation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">{{ object.company_id.name }} Order (Ref {{ object.name or 'n/a' }} - {{ object.date_order and object.date_order.strftime('%Y-%m-%d') or '' }})</field>
            <field name="email_from">"{{ object.company_id.name }}" &lt;noreply@silverhorn.co.uk&gt;</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Sent to customers on order confirmation</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <t t-set="base_url" t-value="object.env['ir.config_parameter'].sudo().get_param('web.base.url') or ''"/>
    <t t-set="order_date" t-value="object.date_order and object.date_order.strftime('%Y-%m-%d') or ''"/>

    <p style="margin: 0px; padding: 0px; font-size: 16px;">
        Hello, <t t-out="object.partner_id.name"/>
        <br/><br/>
        Your enquiry <span style="font-weight:bold;" t-out="object.name or ''">S00049</span>
        (<span t-out="order_date"/>) has been confirmed.<br/>
        Thank you for your trust!
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <br/><br/>
            <t t-out="object.user_id.signature or ''">--<br/>Mitchell Admin</t>
        </t>
        <br/><br/>
    </p>

    <t t-set="products" t-value="object.order_line.filtered(lambda l: (not hasattr(l, 'is_delivery') or not l.is_delivery))"/>
    <t t-set="parts" t-value="object.brochure_line_ids if hasattr(object, 'brochure_line_ids') else []"/>

    <!-- ================= Parts (sale.order.line) ================= -->
    <t t-if="products">
        <table width="100%" style="color: #454748; font-size: 12px; border-collapse: collapse; margin: 0 0 20px 0; table-layout: fixed;">
            <colgroup>
                <col style="width: 26%;"/>
                <col style="width: 14%;"/>
                <col style="width: 12%;"/>
                <col style="width: 14%;"/>
                <col style="width: 14%;"/>
                <col style="width: 12%;"/>
                <col style="width: 8%;"/>
            </colgroup>
            <thead>
                <tr style="border-bottom: 2px solid #dee2e6;">
                    <th align="left"><span style="font-weight:bold;">Parts</span></th>
                    <th align="center"><span style="font-weight:bold;">Part number</span></th>
                    <th align="center"><span style="font-weight:bold;">Make</span></th>
                    <th align="center"><span style="font-weight:bold;">Category</span></th>
                    <th align="center"><span style="font-weight:bold;">Subcategory</span></th>
                    <th align="center"><span style="font-weight:bold;">Part type</span></th>
                    <th align="center"><span style="font-weight:bold;">Qty</span></th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="products" t-as="line">
                    <t t-set="tmpl" t-value="line.product_id.product_tmpl_id"/>
                    <t t-set="deepest_cat" t-value="tmpl.public_categ_ids[:1]"/>
                    <t t-set="chain_ids" t-value="[int(i) for i in (deepest_cat.parent_path or '').strip('/').split('/') if i] if deepest_cat else []"/>
                    <t t-set="chain" t-value="line.env['product.public.category'].sudo().browse(chain_ids)"/>
                    <t t-set="category_name" t-value="chain[0].name if len(chain) &gt;= 1 else ''"/>
                    <t t-set="subcategory_name" t-value="chain[1].name if len(chain) &gt;= 2 else ''"/>
                    <t t-set="part_type_name" t-value="chain[2].name if len(chain) &gt;= 3 else ''"/>
                    <tr t-att-style="'background-color: #f2f2f2' if line_index % 2 == 0 else 'background-color: #ffffff'">
                        <t t-if="line.display_type == 'line_section'">
                            <td colspan="7"><span style="font-weight:bold;" t-out="line.name or ''"/></td>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <td colspan="7"><i t-out="line.name or ''"/></td>
                        </t>
                        <t t-else="">
                            <td align="left">
                                <t t-if="tmpl.website_slug">
                                    <a t-att-href="base_url + tmpl.website_slug" t-out="line.product_id.name or ''"/>
                                </t>
                                <t t-else="">
                                    <span t-out="line.product_id.name or ''"/>
                                </t>
                            </td>
                            <td align="center" t-out="line.product_id.default_code or ''"/>
                            <td align="center" t-out="(tmpl.make_id and tmpl.make_id.name) or ''"/>
                            <td align="center" t-out="category_name"/>
                            <td align="center" t-out="subcategory_name"/>
                            <td align="center" t-out="part_type_name"/>
                            <td align="center" t-out="line.product_uom_qty or ''"/>
                        </t>
                    </tr>
                </t>
            </tbody>
        </table>
    </t>

    <!-- ================= Requests (brochure lines) ================= -->
    <t t-if="parts">
        <table width="100%" style="color: #454748; font-size: 12px; border-collapse: collapse; table-layout: fixed;">
            <colgroup>
                <col style="width: 24%;"/>
                <col style="width: 14%;"/>
                <col style="width: 16%;"/>
                <col style="width: 16%;"/>
                <col style="width: 22%;"/>
                <col style="width: 8%;"/>
            </colgroup>
            <thead>
                <tr style="border-bottom: 2px solid #dee2e6;">
                    <th align="left"><span style="font-weight:bold;">Requests</span></th>
                    <th align="center"><span style="font-weight:bold;">Make</span></th>
                    <th align="center"><span style="font-weight:bold;">Model / Serial</span></th>
                    <th align="center"><span style="font-weight:bold;">Part number</span></th>
                    <th align="center"><span style="font-weight:bold;">Description</span></th>
                    <th align="center"><span style="font-weight:bold;">Qty</span></th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="parts" t-as="part">
                    <tr t-att-style="'background-color: #f2f2f2' if part_index % 2 == 0 else 'background-color: #ffffff'">
                        <td align="left">
                            <t t-if="part.brochure_id">
                                <a t-att-href="base_url + (part.brochure_id.website_slug or '')" t-out="part.brochure_id.name or ''"/>
                            </t>
                        </td>
                        <td align="center" t-out="part.make or ''"/>
                        <td align="center" t-out="part.machine_serial or ''"/>
                        <td align="center" t-out="part.part_number or ''"/>
                        <td align="center" t-out="part.name or ''"/>
                        <td align="center" t-out="part.quantity or ''"/>
                    </tr>
                </t>
            </tbody>
        </table>
    </t>
</div></field>
            <field name="report_template"/>
            <field name="report_name">{{ (object.name or '').replace('/','_') }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>


        <!-- =========================================================
             COMPANY (silverhorn): Order Confirmation
             ========================================================= -->
